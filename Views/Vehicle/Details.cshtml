
@model VehicleRentalSystem.Models.Vehicle

@{
    ViewData["Title"] = "Vehicle Details";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Vehicle Details</h3>
                </div>

                <div class="card-body">

                    @if (!string.IsNullOrWhiteSpace(Model.Image))
                    {
                        <img src="@Url.Content(Model.Image)"
                             alt="@Model.VehicleName"
                             class="img-fluid rounded mb-4"
                             style="width:100%; height:300px; object-fit:cover;" />
                    }

                    <h2>@Model.VehicleName</h2>

                    <hr />

                    <p>
                        <strong>Brand:</strong>
                        @Model.Brand
                    </p>

                    <p>
                        <strong>Model:</strong>
                        @Model.Model
                    </p>

                    <p>
                        <strong>Vehicle Number:</strong>
                        @Model.VehicleNumber
                    </p>

                    <p>
                        <strong>Category:</strong>
                        @Model.Category
                    </p>

                    <p>
                        <strong>Fuel Type:</strong>
                        @Model.FuelType
                    </p>

                    <p>
                        <strong>Seating Capacity:</strong>
                        @Model.SeatingCapacity
                    </p>

                    <p>
                        <strong>Price Per Day:</strong>
                        <span class="text-success fw-bold">
                            ₹@Model.PricePerDay
                        </span>
                    </p>

                    <p>
                        <strong>Description:</strong>
                        @Model.Description
                    </p>

                    <p>
                        <strong>Status:</strong>

                        @if (Model.Status == "Available")
                        {
                            <span class="badge bg-success">
                                Available
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger">
                                @Model.Status
                            </span>
                        }
                    </p>

                    <hr />

                    <div class="d-flex gap-2 flex-wrap">

                        @if (Context.Session.GetString("IsAdmin") != "true"
                             && Model.Status == "Available")
                        {
                            <a asp-controller="Booking"
                               asp-action="Create"
                               asp-route-vehicleId="@Model.VehicleId"
                               class="btn btn-success">
                                Book Now
                            </a>
                        }

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Back to Vehicles
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>
