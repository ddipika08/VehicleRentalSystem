@model VehicleRentalSystem.Models.Vehicle

@{
    ViewData["Title"] = "Add Vehicle";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-8">

            <div class="card shadow">

                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">Add Vehicle</h3>
                </div>

                <div class="card-body">

                    <form asp-action="Create"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="VehicleName"
                                   class="form-label">
                                Vehicle Name
                            </label>

                            <input asp-for="VehicleName"
                                   class="form-control"
                                   placeholder="Example: Passion Bike 1" />

                            <span asp-validation-for="VehicleName"
                                  class="text-danger">
                            </span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Brand"
                                   class="form-label">
                                Brand
                            </label>

                            <input asp-for="Brand"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Model"
                                   class="form-label">
                                Model
                            </label>

                            <input asp-for="Model"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="VehicleNumber"
                                   class="form-label">
                                Vehicle Number
                            </label>

                            <input asp-for="VehicleNumber"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Category"
                                   class="form-label">
                                Category
                            </label>

                            <input asp-for="Category"
                                   class="form-control"
                                   placeholder="Bike / Car" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="FuelType"
                                   class="form-label">
                                Fuel Type
                            </label>

                            <input asp-for="FuelType"
                                   class="form-control" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="SeatingCapacity"
                                   class="form-label">
                                Seating Capacity
                            </label>

                            <input asp-for="SeatingCapacity"
                                   class="form-control"
                                   type="number" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="PricePerDay"
                                   class="form-label">
                                Price Per Day
                            </label>

                            <input asp-for="PricePerDay"
                                   class="form-control"
                                   type="number"
                                   step="0.01" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description"
                                   class="form-label">
                                Description
                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="3">
                            </textarea>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">
                                Vehicle Image
                            </label>

                            <input type="file"
                                   name="imageFile"
                                   class="form-control"
                                   accept="image/*" />

                            <small class="text-muted">
                                Select bike/car image from your computer.
                            </small>
                        </div>

                        <button type="submit"
                                class="btn btn-success">
                            Add Vehicle
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Back
                        </a>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}