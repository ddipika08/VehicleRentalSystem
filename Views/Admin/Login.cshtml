
@{
    ViewData["Title"] = "Admin Login";
}

<style>
    .admin-login-wrap {
        max-width: 1000px;
        margin: 25px auto;
    }

    .admin-login-card {
        display: grid;
        grid-template-columns: 1fr 1fr;
        overflow: hidden;
        border: 1px solid #E0E7DF;
        border-radius: 24px;
        background: white;
        box-shadow: 0 15px 45px rgba(18, 61, 43, .10);
    }

    .admin-login-banner {
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 42px;
        color: white;
        background: linear-gradient(145deg, #123D2B, #1E6545);
    }

    .admin-login-banner h1 {
        margin: 22px 0 14px;
        color: white;
        font-size: 35px;
        font-weight: 850;
        line-height: 1.2;
    }

    .admin-login-banner p {
        color: #E0EAE1;
    }

    .admin-login-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 68px;
        height: 68px;
        border-radius: 20px;
        color: #123D2B;
        background: #D7F36B;
        font-size: 26px;
        font-weight: 850;
    }

    .admin-login-form {
        padding: 42px;
    }

    .admin-login-form h2 {
        color: #123D2B;
        font-size: 29px;
        font-weight: 850;
    }

    .admin-login-form .form-control {
        min-height: 49px;
        margin-top: 6px;
    }

    .admin-login-submit {
        min-height: 49px;
        margin-top: 10px;
        color: white;
        background: #1E6545;
        border-color: #1E6545;
        font-weight: 750;
    }

    .admin-login-submit:hover {
        color: white;
        background: #123D2B;
        border-color: #123D2B;
    }

    .admin-login-back {
        margin-top: 23px;
        text-align: center;
    }

    .admin-login-back a {
        color: #1E6545;
        font-weight: 700;
    }

    @@media (max-width: 767px) {
        .admin-login-card {
            grid-template-columns: 1fr;
            border-radius: 18px;
        }

        .admin-login-banner {
            padding: 28px;
        }

        .admin-login-banner h1 {
            font-size: 29px;
        }

        .admin-login-form {
            padding: 28px 23px;
        }
    }
</style>

<div class="container admin-login-wrap">
    <div class="admin-login-card">

        <section class="admin-login-banner">
            <div class="admin-login-icon">VR</div>

            <h1>Manage your fleet. Manage every journey.</h1>

            <p>
                Access the administration panel to manage vehicles,
                customers, bookings and rental operations.
            </p>

            <div class="mt-3" style="color:#D7F36B;font-weight:700;">
                Vehicle Rental Management System
            </div>
        </section>

        <section class="admin-login-form">
            <h2>Admin Sign In</h2>
            <p class="text-muted mb-4">
                Enter your administrator credentials.
            </p>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger" role="alert">
                    @ViewBag.Error
                </div>
            }

            <form asp-controller="Admin"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label class="form-label" for="adminEmail">
                        Admin Email
                    </label>

                    <input type="email"
                           id="adminEmail"
                           name="email"
                           class="form-control"
                           placeholder="Enter admin email"
                           autocomplete="username"
                           required />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="adminPassword">
                        Password
                    </label>

                    <input type="password"
                           id="adminPassword"
                           name="password"
                           class="form-control"
                           placeholder="Enter admin password"
                           autocomplete="current-password"
                           required />
                </div>

                <button type="submit"
                        class="btn admin-login-submit w-100">
                    Sign In as Admin →
                </button>
            </form>

            <div class="admin-login-back">
                <a asp-controller="Home" asp-action="Index">
                    ← Back to Home
                </a>
            </div>
        </section>

    </div>
</div>
